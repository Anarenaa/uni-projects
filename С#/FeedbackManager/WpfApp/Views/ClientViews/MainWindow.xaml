<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="500" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button x:Name="LogInButton" Height="40" Width="40" HorizontalAlignment="Right" 
                Style="{x:Null}" Background="Transparent" BorderThickness="0"
                Cursor="Hand" Click="LogInButton_Click">
            <md:PackIcon Kind="LoginVariant" 
                         Width="30" 
                         Height="30" 
                         Foreground="Black" />
        </Button>

        <Label Grid.Row="1" Content="Оцінка (від 0 до 10)*:"
               FontWeight="Bold" Foreground="Black"
               Margin="0,5"/>
        <TextBox x:Name="RateTextBox" Grid.Row="2" 
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Text="{Binding FeedbackRate, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Top"
                 md:HintAssist.Hint="10"
                 md:HintAssist.IsFloating="False"
                 md:HintAssist.Foreground="Black"
                 Padding="10,8"/>

        <Label Grid.Row="3" Content="Відгук*:"
               FontWeight="Bold" Foreground="Black" 
               Margin="0,10,0,5"/>
        <TextBox x:Name="FeedbackTextBox" Grid.Row="4" 
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 TextWrapping="Wrap"
                 Text="{Binding FeedbackMessage}"
                 VerticalContentAlignment="Top"
                 md:HintAssist.Hint="..."
                 md:HintAssist.IsFloating="False"
                 md:HintAssist.Foreground="Black"/>

        <Button x:Name="SendButton" Grid.Row="5"
                Content="Відправити"
                Height="40"
                Margin="0,10,0,0"
                Click="SendButton_Click"/>
    </Grid>
</Window>
