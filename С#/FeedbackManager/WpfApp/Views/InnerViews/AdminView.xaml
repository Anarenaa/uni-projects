<Window x:Class="WpfApp.Views.InnerViews.AdminView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:WpfApp.Views.InnerViews"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="AdminView" Height="600" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid>
        <Button Grid.Column="0" x:Name="ExitButton"
                Command="{Binding ExitCommand}"
                Style="{x:Null}" 
                Width="40" Height="48"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                Background="Transparent"
                Cursor="Hand">
            <md:PackIcon Kind="ExitToApp" 
                 Width="20" 
                 Height="20" 
                 RenderTransformOrigin="0.5,0.5">
                <md:PackIcon.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </md:PackIcon.RenderTransform>
            </md:PackIcon>
        </Button>
        <TabControl Margin="40,0,0,0">
            <TabItem Header="Користувачі">
                <Grid Margin="-40,0,0,0">
                    <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True"
                              Background="White" Margin="0,0,0,40"
                              SelectedItem="{Binding SelectedUser, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="Auto"/>
                            <DataGridTextColumn Header="Ім'я" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding PhoneNumber}" Width="Auto"/>
                            <DataGridTextColumn Header="Посада" Binding="{Binding Role}" Width="*"/>
                            <DataGridTextColumn Header="Логін" Binding="{Binding Login}" Width="*"/>
                            <DataGridTextColumn Header="Пароль" Binding="{Binding Password}" Width="*"/>
                            <DataGridTextColumn Header="Дата створення" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid VerticalAlignment="Bottom" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="Додати" Command="{Binding OpenAddUserPopupCommand}"/>
                        <Button Grid.Column="1" Command="{Binding EditUserCommand}"
                                IsEnabled="{Binding IsSelectedUser}">
                            <md:PackIcon Kind="Edit" Width="20"/>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding DeactivateUserCommand}"
                                IsEnabled="{Binding IsSelectedUser}">
                            <md:PackIcon Kind="Delete" Width="20"/>
                        </Button>
                    </Grid>
                </Grid>
                
            </TabItem>
            <TabItem Header="Аналітика">
                <Grid Margin="-40,0,0,0" DataContext="{Binding StatsVM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Background="#F5F5F5">
                        <ScrollViewer>
                            <StackPanel Margin="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Text="Аналітичний звіт" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
                                    <ComboBox Grid.Column="1"
                                              SelectedValuePath="Tag" 
                                              SelectedValue="{Binding SelectedPeriod}">
                                        <ComboBoxItem Tag="7" Content="За останній тиждень"/>
                                        <ComboBoxItem Tag="30" Content="За останній місяць"/>
                                        <ComboBoxItem Tag="92" Content="За останні 3 місяці"/>
                                        <ComboBoxItem Tag="183" Content="За останні півроку"/>
                                        <ComboBoxItem Tag="365" Content="За останній рік"/>
                                        <ComboBoxItem Tag="0" Content="За весь час"/>
                                    </ComboBox>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <TextBlock Text="Загальна кількість проаналізованих відгуків: " VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding FeedbacksTotalCount}" VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
                                </StackPanel>

                                <UniformGrid Columns="2">
                                    <GroupBox Header="Оцінки" Margin="5" Height="300">
                                        <oxy:PlotView Model="{Binding RatingModel}"/>
                                    </GroupBox>

                                    <GroupBox Header="Категорії (Кількість)" Margin="5" Height="300">
                                        <oxy:PlotView Model="{Binding CategoryPieModel}"/>
                                    </GroupBox>

                                    <GroupBox Header="Рейтинг" Margin="5" Height="300">
                                        <oxy:PlotView Model="{Binding CategoryAvgModel}"/>
                                    </GroupBox>

                                    <GroupBox Header="Динаміка" Margin="5" Height="300">
                                        <oxy:PlotView Model="{Binding TimelineModel}"/>
                                    </GroupBox>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Button Grid.Row="1" Content="Згенерувати звіт" Height="50" 
                            Command="{Binding GenerateTimedReportCommand}"
                            />
                    <Button Grid.Row="2" Content="Історія дій" Height="50"
                            x:Name="ShowLogButton"
                            Click="ShowLogButton_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
        
    </Grid>
</Window>
