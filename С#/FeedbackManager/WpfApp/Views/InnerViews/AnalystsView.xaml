<Window x:Class="WpfApp.Views.InnerViews.AnalystsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:WpfApp.Views.InnerViews"
        xmlns:converters="clr-namespace:WpfApp.Views.Converters"
        xmlns:viewModels="clr-namespace:WpfApp.ViewModels"
        mc:Ignorable="d"
        Title="AnalystsView" Height="600" Width="800" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:MultiBoolToVisibilityConverter x:Key="MultiBoolToVis"/>
        <converters:CategoryIdToBoolConverter x:Key="CategoryIdToBoolConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!--Filter panel-->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding ExitCommand}"
                        Style="{x:Null}" Width="40"
                        Background="Transparent" Cursor="Hand">
                    <md:PackIcon Kind="ExitToApp" 
                                 Width="20" 
                                 Height="20" 
                                 RenderTransformOrigin="0.5,0.5">
                        <md:PackIcon.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </md:PackIcon.RenderTransform>
                    </md:PackIcon>
                </Button>

                <TextBox Grid.Column="1" x:Name="SearchTextBox"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="Пошук" 
                         md:HintAssist.IsFloating="False"
                         md:TextFieldAssist.UnderlineBrush="Black"
                         FontSize="14"
                         Padding="15,5"
                         Height="40"
                         BorderBrush="Black"
                         BorderThickness="0,0,0,1"/>

                <Button Grid.Column="2" x:Name="FilterButton"
                        Style="{x:Null}" Width="40"
                        Background="Transparent" Cursor="Hand"
                        Visibility="{Binding IsBoss, Converter={StaticResource BoolToVis}}"
                        Click="FilterButton_Click">
                    <md:PackIcon Kind="FilterVariant" x:Name="FilterIcon" Width="20" Height="20"/>
                </Button>
                <Button Grid.Column="3" Command="{Binding RefreshFeedbacksCommand}"
                        Style="{x:Null}" Width="40"
                        Background="Transparent" Cursor="Hand">
                    <md:PackIcon Kind="Reload" Width="20" Height="20"/>
                </Button>
            </Grid>

            <!--Filter by tag-->
            <ItemsControl Grid.Row="1" Margin="5" Name="TagFilterPanel"
                          Visibility="{Binding IsBoss, Converter={StaticResource BoolToVis}}"
                          ItemsSource="{Binding FilterCategories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding DataContext.SelectedCategoryIds, 
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}, 
                                            Converter={StaticResource CategoryIdToBoolConverter}}"
                                  Tag="{Binding Id}"
                                  Command="{Binding DataContext.ToggleCategoryFilterCommand, 
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding Id}"
                                  Style="{StaticResource MaterialDesignFilterChipOutlineCheckBox}"
                                  Margin="0,0,4,4">
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>

        <TextBlock Grid.Row="1" Text="Нових відгуків немає"
                   HorizontalAlignment="Center" Margin="0,20,0,0"
                   FontSize="18" FontWeight="DemiBold"
                   Visibility="{Binding IsNoFeedback, Converter={StaticResource BoolToVis}}"/>

        <!--Feedback List-->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Feedbacks}"
                          Margin="10"
                          BorderThickness="0"
                          Background="{x:Null}"
                          HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="12"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="#DDDDDD"
                                Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding AuthorName}"
                                               FontWeight="Bold"
                                               FontSize="16"/>
                                            <TextBlock Text=" · "
                                               FontSize="12"
                                               Foreground="Gray"
                                               Margin="4,0,4,0"
                                               VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding AuthorEmail}"
                                               FontSize="12"
                                               Foreground="Gray"
                                               VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Text="ВАЖЛИВО" FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="Red"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource MultiBoolToVis}">
                                                    <Binding Path="DataContext.IsBoss" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    <Binding Path="IsImportant" />
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Rate}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                        <TextBlock Text="★"
                                           FontSize="13"
                                           Foreground="Gold"
                                           VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Margin="0,8,0,0"
                                    Padding="8"
                                    Background="#FAFAFA"
                                    CornerRadius="6">
                                        <TextBlock Text="{Binding Comment}"
                                           FontSize="14"
                                           TextWrapping="Wrap"/>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!--Temp Tags-->
                                        <ItemsControl ItemsSource="{Binding TempTags}" Margin="0,8,0,0"
                                                      Visibility="{Binding DataContext.IsAnalyst, 
                                                                           RelativeSource={RelativeSource AncestorType=ItemsControl}, 
                                                                           Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent"
                                                    BorderThickness="1"
                                                    BorderBrush="#DDD"
                                                    CornerRadius="16" 
                                                    Padding="12,8"
                                                    Margin="0,0,4,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" 
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0"/>
                                                            <Button Content="X"
                                                                    Command="{Binding DataContext.RemoveTagCommand, 
                                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding .}"
                                                                    Visibility="{Binding DataContext.IsAnalyst, 
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Foreground="#000"
                                                                    Cursor="Hand"
                                                                    Margin="4,0">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="Transparent">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--Saved Tags-->
                                        <ItemsControl ItemsSource="{Binding FeedbackCategories}" Margin="0,8,0,0"
                                                      Visibility="{Binding DataContext.IsBoss, 
                                                                           RelativeSource={RelativeSource AncestorType=ItemsControl}, 
                                                                           Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent"
                                                            BorderThickness="1"
                                                            BorderBrush="#DDD"
                                                            CornerRadius="16" 
                                                            Padding="12,8"
                                                            Margin="0,0,4,4">
                                                    <TextBlock Text="{Binding Category.Name}" 
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,4,0"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding SubmittedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}}"
                                                   Grid.Column="1"
                                                   FontSize="11"
                                                   Foreground="Gray"
                                                   Margin="0,6,0,0"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!--Analysts Panel-->

                                <Grid Grid.Column="1" 
                                      Visibility="{Binding DataContext.IsAnalyst, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"
                                      Margin="16,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="1" Background="#DDDDDD"/>

                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <ToggleButton Content="Проаналізовано" 
                                              Command="{Binding DataContext.AnalyzeFeedbackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"
                                              Style="{StaticResource MaterialDesignChoiceChipOutlineRadioButton}"/>

                                        <ToggleButton Content="Важливо" 
                                              IsChecked="{Binding DataContext.IsImportant,
                                                                Mode=TwoWay, 
                                                                UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource MaterialDesignChoiceChipOutlineRadioButton}"/>

                                        <Button Content="Додати тег"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding DataContext.AddTagCommand, 
                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding .}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2"
                x:Name="OpenStatsWindow"
                Content="Подивитись аналітику"
                Visibility="{Binding IsBoss, Converter={StaticResource BoolToVis}}"
                Click="OpenStatsWindow_Click"/>
    </Grid>
</Window>
