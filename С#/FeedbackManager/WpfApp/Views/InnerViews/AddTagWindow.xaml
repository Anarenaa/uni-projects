<Window x:Class="WpfApp.Views.InnerViews.AddTagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp.Views.InnerViews"
        mc:Ignorable="d"
        Title="AddTagWindow" Height="450" Width="400" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <DataGrid CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                  Background="White"  AutoGenerateColumns="False"
                  Visibility="{Binding IsAnyCategories, Converter={StaticResource BoolToVis}}"
                  ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ім'я тегу" Binding="{Binding Name}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel HorizontalAlignment="Center" Margin="0,40,0,0" >
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAnyCategory}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Немає тегів" FontSize="24" HorizontalAlignment="Center" FontWeight="Bold"/>
            <TextBlock Text="Додайте новий" FontSize="24" HorizontalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <Button Content="Обрати" Command="{Binding AddTagCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/> 
            <Button Grid.Column="1" Content="+" 
                    Command="{Binding OpenNewCategoryWindowCommand}"/>
            <Button Grid.Column="2" Content="E" Command="{Binding EditCategoryCommand}"/>
            <Button Grid.Column="3" Content="D" Command="{Binding DeleteCategoryCommand}"/> 
        </Grid>
    </Grid>
</Window>
