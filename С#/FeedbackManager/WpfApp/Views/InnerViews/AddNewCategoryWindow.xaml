<Window x:Class="WpfApp.Views.InnerViews.AddNewCategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp.Views.InnerViews"
        mc:Ignorable="d"
        Title="AddNewCategoryWindow" Height="250" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="50,0">
        <StackPanel VerticalAlignment="Center">
            <Label Content="Назва*" FontWeight="Bold"/>
            
            <TextBox x:Name="LoginTextBox"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding NewCategoryName}"
                     VerticalContentAlignment="Center"
                     Padding="10,8"/>
            <Button Content="Додати" Margin="0,20,0,0"
                    Visibility="{Binding IsNotEditMode, Converter={StaticResource BoolToVis}}"
                    Command="{Binding AddNewCategoryCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

            <Button Content="Зберегти" Margin="0,20,0,0"
                     Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"
                    Command="{Binding SaveCategoryChangesCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</Window>
