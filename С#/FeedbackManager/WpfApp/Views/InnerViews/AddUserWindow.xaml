<Window x:Class="WpfApp.Views.InnerViews.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp.Views.InnerViews"
        xmlns:converters="clr-namespace:WpfApp.Views.Converters"
        mc:Ignorable="d"
        Height="450" Width="400" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:RoleToUkrainianConverter x:Key="RoleToStringConverter"/>
    </Window.Resources>
    <Grid Margin="80 0" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Посада*" FontWeight="Bold"
               Visibility="{Binding IsNotEditMode, Converter={StaticResource BoolToVis}}"/>
        <ComboBox Grid.Row="1" ItemsSource="{Binding Roles}" 
                  SelectedIndex="0" SelectedValue="{Binding SelectedRole}"
                  Visibility="{Binding IsNotEditMode, Converter={StaticResource BoolToVis}}"
                  Style="{StaticResource MaterialDesignComboBox}"
                  Margin="5">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource RoleToStringConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        
        <Label Grid.Row="2" Content="Ім'я та Прізвище*" 
               FontWeight="Bold" Margin="0,8,0,0"/>
        <TextBox x:Name="LoginTextBox" Grid.Row="3" 
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Text="{Binding NewFullName}"
                 VerticalContentAlignment="Top"
                 Padding="10,8"/>

        <Label Content="Номер телефону*" FontWeight="Bold"
               Grid.Row="4" Margin="0,8,0,0"/>
        <TextBox x:Name="PhoneNumberTextBox" Grid.Row="5" 
                 Text="{Binding NewPhoneNumber}"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 VerticalContentAlignment="Top"
                 Padding="10,8"/>

        <Button x:Name="AddButton" Grid.Row="6"
                Visibility="{Binding IsNotEditMode, Converter={StaticResource BoolToVis}}"
                Command="{Binding AddNewUserCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Content="Додати"
                Height="40"
                Margin="0,24,0,0"/>
        <Button x:Name="EditSaveButton" Grid.Row="6"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"
                Command="{Binding SaveUserChangesCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Content="Зберегти"
                Height="40"
                Margin="0,24,0,0"/>
    </Grid>
</Window>
