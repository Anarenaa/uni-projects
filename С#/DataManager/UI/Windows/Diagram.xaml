<Window x:Class="UI.Windows.Diagram"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:local="clr-namespace:UI.Windows"
        mc:Ignorable="d"
        Title="Diagram" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        
        <scottPlot:WpfPlot x:Name="wpfPlot" Margin="15 0"/>
        <Button x:Name="SaveButton" Grid.Row="1" Content="Save PNG" HorizontalAlignment="Right" Width="150" Margin="15" Click="SaveButton_Click"/>
    </Grid>
</Window>
